# 开发环境配置
# NODE_ENV 由 Vite 按 mode 自动注入，请勿在此手动设置

# 应用标题
VITE_APP_TITLE=Agent Frontend (Dev)

# 本地开发服务器端口
VITE_PORT=5173

# 接口请求前缀（与 vite.config.ts 中代理规则匹配）
VITE_API_PREFIX=/api

# 跨域代理目标地址（后端服务地址）
VITE_PROXY_TARGET=http://localhost:8000

# 接口基础路径（axios 实例使用；开发环境走 Vite 代理同源转发，置空即可，
# 请求直接使用后端真实路径 /api/v1/*（含 /api/v1/auth/*））
VITE_API_BASE_URL=

# 是否开启调试日志
VITE_LOG_ENABLED=true
